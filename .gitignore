# Zip archives
*.zip
*.tar.gz
project_aws.zip
student_resource.zip
__MACOSX/

# Raw large dataset folders (> 100 MB each, blocked by GitHub)
student_resource/dataset/

# Full processed datasets (> 100 MB each, blocked by GitHub)
business_entity_resolution/data/processed/*.parquet
business_entity_resolution/data/processed/*.tsv
business_entity_resolution/data/processed/*.csv
business_entity_resolution/data/processed/*.h5

# Allow working sample parquet datasets (< 15 MB each)
!business_entity_resolution/data/processed/sample/
!business_entity_resolution/data/processed/sample/**

# Keep directory structure
!business_entity_resolution/data/**/*.gitkeep
!business_entity_resolution/output/**/*.gitkeep

# Model weights and checkpoints
*.pkl
*.pickle
*.joblib
*.model
*.bin
*.pt
*.onnx

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
venv/
env/
.venv/
ENV/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDE and OS metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
